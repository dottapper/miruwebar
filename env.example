# 環境変数設定例
# このファイルをコピーして .env ファイルを作成してください

# ログレベル設定
# DEBUG, INFO, WARN, ERROR
VITE_LOG_LEVEL=INFO

# サーバー設定
PORT=3000
NODE_ENV=development

# 本番環境でのログ制御
# 本番環境では WARN または ERROR を推奨
# LOG_LEVEL=WARN

# ========================================
# 認証設定（シンプルパスワード認証）
# ========================================
# AUTH_PASSWORD: ログイン時に入力するパスワード
# AUTH_SECRET: Cookieに保存するランダムな文字列（32文字以上推奨）
#
# 両方を設定すると認証が有効になります
# 設定しない場合は認証なしでアクセス可能です
#
# AUTH_SECRETの生成例（ターミナルで実行）:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
AUTH_PASSWORD=your-secure-password-here
AUTH_SECRET=your-random-secret-string-32-chars-or-more
# ========================================

# ========================================
# 公開ストレージプロバイダ設定
# ========================================
# 公開リリース作成時に使用するストレージプロバイダ
#   vercelBlob : 既定。/api/publish-project 経由で公開
#   firebase   : 後方互換。Firebase Storage を使用
# 未設定の場合は vercelBlob を使用します
# VITE_STORAGE_PROVIDER=vercelBlob

# Vercel Blob トークン（本番/Preview で vercelBlob を使う場合に必須）
# Vercel ダッシュボードの Storage > Blob で発行し、プロジェクトの環境変数に設定する
# （ローカル開発 npm run dev では不要。未設定時は public/projects/ に書き出し）
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ========================================
# トンネルURL設定（任意）
# ========================================
# 「トンネルURLでテスト」のQRに使う公開URL（ngrok / Cloudflare Tunnel など）
# QRモーダルの入力欄でも設定でき、入力欄の値が環境変数より優先されます
# VITE_PUBLIC_TUNNEL_URL=https://xxxx.ngrok-free.app

# ========================================
# Firebase設定（firebaseプロバイダ使用時に必須）
# ========================================
# セキュリティのため、環境変数での設定が必須です
# Firebase Console (https://console.firebase.google.com/) から取得してください
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
