# 環境変数設定例
# このファイルをコピーして .env ファイルを作成してください

# ログレベル設定
# DEBUG, INFO, WARN, ERROR
VITE_LOG_LEVEL=INFO

# サーバー設定
PORT=3000
NODE_ENV=development

# 本番環境でのログ制御
# 本番環境では WARN または ERROR を推奨
# LOG_LEVEL=WARN

# ========================================
# 認証設定（シンプルパスワード認証）
# ========================================
# AUTH_PASSWORD: ログイン時に入力するパスワード
# AUTH_SECRET: Cookieに保存するランダムな文字列（32文字以上推奨）
#
# 両方を設定すると認証が有効になります
# 設定しない場合は認証なしでアクセス可能です
#
# AUTH_SECRETの生成例（ターミナルで実行）:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
AUTH_PASSWORD=your-secure-password-here
AUTH_SECRET=your-random-secret-string-32-chars-or-more
# ========================================

# Firebase設定（必須）
# セキュリティのため、環境変数での設定が必須です
# Firebase Console (https://console.firebase.google.com/) から取得してください
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
