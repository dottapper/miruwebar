{
  "name": "miruwebar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fresh": "vite --force",
    "build": "vite build",
    "build:clean": "rm -rf dist/ && npm run build",
    "build:verify": "npm run build:clean && npm run build:check",
    "build:check": "node scripts/verify-build.js",
    "preview": "vite preview",
    "server": "node server/simple-server.js",
    "server:https": "USE_HTTPS=true node server/simple-server.js",
    "dev:server": "node server/simple-server.js",
    "start": "npm run build && node server/simple-server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:debug": "VITE_LOG_LEVEL=DEBUG npm run dev",
    "dev:info": "VITE_LOG_LEVEL=INFO npm run dev",
    "dev:warn": "VITE_LOG_LEVEL=WARN npm run dev",
    "dev:error": "VITE_LOG_LEVEL=ERROR npm run dev",
    "build:prod": "VITE_LOG_LEVEL=WARN npm run build",
    "check:start": "node ./scripts/check-start-screen.js",
    "cleanup:projects": "node src/scripts/cleanup-project-duplicates.js"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^25.0.1",
    "puppeteer": "^24.9.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "rimraf": "^5.0.11",
    "glob": "^10.4.5",
    "basic-ftp": "^5.2.3",
    "protobufjs": "^7.5.5",
    "axios": "^1.13.2",
    "follow-redirects": "^1.16.0",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "postcss": "^8.5.6",
    "rollup": "^4.59.0",
    "picomatch": "^4.0.3",
    "qs": "^6.14.2",
    "path-to-regexp": "^8.3.0"
  },
  "dependencies": {
    "@ar-js-org/ar.js-threejs": "^0.3.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "firebase": "^12.7.0",
    "fs-extra": "^11.3.0",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1",
    "three": "0.165.0",
    "uuid": "^14.0.0"
  }
}
